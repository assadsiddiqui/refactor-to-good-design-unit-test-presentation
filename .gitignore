# .NET Git ignore file
# Generated from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Bb]in/
obj/
[Oo]bj/

# Uncomment if you have tasks that create the project's static files in wwwroot
#wwwroot/

# Visual Studio 2015 cache/options directory
.vs/

# Rider
.idea/

# Autogenerated VS Code local history and workspace storage
.vscode/

# NuGet packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# NuGet v3's project.json files
project.lock.json
project.fragment.lock.json

# NuGet v2
packages.config

# Microsoft Azure Web App publish settings
*.Publish.xml

# MSBuild generated files
*.pidb
*.svclog
*.userprefs

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# TFS
$tf/

# Guidance automation toolkit
*.gpState

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper*
*.DotSettings.user

# JustCode
*.JustCode

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# AxoCover
*.axoCover

# Visual Studio cache files
*.cache
*.ilk
*.log
*.tlog
*.tmp
*.tmp_proj
*.log.*

# Visual Studio database files
*.mdf
*.ldf

# SQL Server files
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings

# Azure Stream Analytics local run output
JobConfig.local.json

# Node.js
node_modules/

# npm packages
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# dotnet publish output
*.Publish.xml

# Others
*.dbmdl
*.bak
*.Backup
*.cache
*.ilg
*.ipch
*.iobj
*.sbr
*.tlb
*.tli
*.tmp
*.tmp_proj
*.log

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/
